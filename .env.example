# Bot token from https://discord.com/developers/applications
# (Bot -> Reset Token). Never commit the real value.
TOKEN=

# Optional: post the command list on startup, matched by name.
# Leave blank to skip the announcement.
ANNOUNCE_GUILD=
ANNOUNCE_CHANNEL=

# Optional: only needed if ffmpeg is not on your PATH.
FFMPEG_PATH=

# Optional overrides
COMMAND_PREFIX=!
SOUNDS_FOLDER=saved-sounds
